# Copy to .env (never commit it). Everything here is read by the server only.

# Public URL of the site, no trailing slash. Used for canonical URLs, the sitemap and robots.txt.
APP_URL="https://www.example.com"

# Set to 1 when the app runs behind ONE reverse proxy / load balancer (Cloud Run, nginx, ...),
# so rate limits and secure cookies use the real client address. Leave unset when exposed directly.
TRUST_PROXY=

# First administrator. Used only when the database has no active admin.
# If ADMIN_INITIAL_PASSWORD is empty or shorter than 12 characters, a random password is generated
# and printed ONCE in the server log. There are no default passwords.
ADMIN_EMAIL="you@example.com"
ADMIN_INITIAL_PASSWORD=""

# Public contact mailbox shown on the site (editable later in Admin > SEO & Legal). Must be one you read.
SUPPORT_EMAIL=""

# Optional. Can also be set in Admin. Ads and analytics stay OFF until the visitor consents.
VITE_GA4_MEASUREMENT_ID=""
VITE_ADSENSE_PUBLISHER_ID=""
